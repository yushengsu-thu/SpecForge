+                logger.info(
+                    "validation step: %d loss: %.6f accuracy: %.6f",
+                    step,
+                    self.last_metrics["eval/avg_loss"],
+                    self.last_metrics["eval/avg_acc"],
+                )
+        finally:
+            for module, was_training in modes:
+                module.training = was_training
