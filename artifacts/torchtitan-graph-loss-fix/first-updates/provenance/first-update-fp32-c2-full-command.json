{
  "command": [
    "/scratch/specforge-torchtitan-20261003/venv/bin/python",
    "-m",
    "torch.distributed.run",
    "--standalone",
    "--nproc-per-node=2",
    "/scratch/specforge-torchtitan-20261003/collect_titan_first_updates.py",
    "--specforge-root",
    "/scratch/specforge-torchtitan-20261003/first-update-source-candidate2",
    "--backend",
    "torchtitan",
    "--algorithm",
    "dflash2",
    "--tiny",
    "--seq-length",
    "128",
    "--num-anchors",
    "8",
    "--objective-chunk-blocks",
    "2",
    "--warmup-steps",
    "1",
    "--steps",
    "1",
    "--attention",
    "eager",
    "--compile",
    "--cuda-graphs",
    "--titan-engine",
    "graph",
    "--graph-inductor",
    "full",
    "--output",
    "/scratch/specforge-torchtitan-20261003/first-update-fp32-c2-full.json"
  ],
  "environment": {
    "CUDA_VISIBLE_DEVICES": "0,1",
    "OMP_NUM_THREADS": "1",
    "COLLECT_FLOAT32": "1",
    "COLLECT_TINY_HEAD_DIM": "16",
    "COLLECT_DISABLE_GRAPH_PASSES": "0",
    "COLLECT_KEEP_FLEX_PASSES": "0",
    "COLLECT_DRIVER": "/scratch/specforge-torchtitan-20261003/first-update-driver-candidate1/scripts/benchmark_training_backends.py",
    "COLLECT_DIRECTORY": "/scratch/specforge-torchtitan-20261003/first-update-fp32-c2-full",
    "PROBE_PRESERVE_CASTS": "1",
    "PROBE_DIVISION_ROUNDING": "1"
  }
}
