diff --git a/python/sglang/srt/stop_file.py b/python/sglang/srt/stop_file.py
new file mode 100644
index 0000000..2216131
--- /dev/null
+++ b/python/sglang/srt/stop_file.py
@@ -0,0 +1,30 @@
+"""Opt-in self-termination for a server process that cannot be signalled.
+
+Some sandboxes (seccomp policies that deny ``kill``) leave a launched server
+unstoppable from the outside. When ``SGLANG_STOP_FILE`` is set, the server's
+main process polls that path and exits with ``os._exit(0)`` once the file
+exists; its scheduler/detokenizer children die with it through
+``PR_SET_PDEATHSIG`` (see ``kill_itself_when_parent_died``), which frees the
+GPU without any signal being sent across processes.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+import time
+
+
+def start_stop_file_watchdog(poll_seconds: float = 2.0) -> bool:
+    path = os.environ.get("SGLANG_STOP_FILE")
+    if not path:
+        return False
+
+    def _watch() -> None:
+        while True:
+            time.sleep(poll_seconds)
+            if os.path.exists(path):
+                os._exit(0)
+
+    threading.Thread(target=_watch, name="sglang-stop-file", daemon=True).start()
+    return True
