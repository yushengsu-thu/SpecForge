+    def check_loaded(self, where: str) -> None:
+        """Refuse to serve a partially loaded FFN."""
+        missing = [
+            f"experts.{expert_id}.{shard}"
+            for expert_id in range(self.spec.num_experts)
+            for shard in ("w1", "w2", "w3")
